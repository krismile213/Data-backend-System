# 数据后台系统 —— 环境变量模板
# ============================================================
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会提交。
#
# 加载优先级（单一真源：backend/app/env_loader.py::load_project_env）：
#   1) 环境变量 DATA_ADMIN_ENV_FILE 指向的文件
#   2) D:\apps\data-admin\.env      ← 当前部署**实际使用**的一份（本机实际生效文件）
#   3) <仓库根>\.env
#   4) <仓库>\backend\.env
# 只加载**首个存在**的文件（后面的一律不看），且不会覆盖已存在的环境变量（override=False）。
# ⚠️ 由于候选 2 已存在，它会遮蔽候选 3/4 —— 在仓库根新建 .env 不会生效，
#    请把要覆盖的键（如 AGENT_TOKEN）写进候选 2 那份文件。
# ============================================================

# ---------- MySQL 连接 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=data_admin

# ---------- 数据根目录 ----------
# 其下每个含 Part*.xlsx 的子目录视为一个批次
# 留空/不设置则使用 backend/app/config.py 里的默认值
DATA_ROOT=C:\Users\dell\Desktop\work-main\data\手机膜

# ---------- AI 助手 BFF 反向代理 ----------
# 平台后端（backend/app/routers/agent_proxy.py）在**服务端**注入
#   Authorization: Bearer <AGENT_TOKEN>
# 前端只走相对路径、永不接触 token。真实 .env 的载入顺序见 backend/app/env_loader.py。
AGENT_TOKEN=
# ↑ 必须与 Agent（server.py）config.json → auth.tokens[0] **完全一致**；
#   留空 = 不注入 Authorization（Agent 本机/无鉴权模式）。
#   ⚠️ 与 Agent 的 config.json 是「两份存储」，改一处必须同步另一处。
# Agent 上游地址（HTTP 适配器，默认 :8765）
AGENT_BASE_URL=http://127.0.0.1:8765
# 转发读取超时（秒）。SSE 是长连接，必须给足。
AGENT_TIMEOUT=300

# ---------- 启动预热（可选，不写就用内置默认值） ----------
# 后端启动后在后台线程里把批次/复盘/预警缓存先算好，**只在没人访问时动手**，
# 因此不会拖慢「服务一就绪就打开页面」的首次访问。
# 实测收益：切换批次合计 3.43s → 0.11s（详见 README 第四节 / docs/性能优化与前端改造方案.md）
# 设 0 / false 可完全关闭预热：
# PREWARM=1
# 启动后先等多少秒再考虑预热（默认 10；用于避开「浏览器已开、前端还在加载模块」的空窗）
# PREWARM_DELAY=10
